  "item": [
    {
      "id": "db89071f-0119-4720-b638-ac27752a4cab",
      "name": "chat",
      "description": {
        "content": "Create model responses for chat conversations.\n\nSupports:\n- **Multi-turn dialogue** with conversation history\n- **System prompts** to control model behavior\n- **Tool calling** for function execution and structured outputs\n- **Streaming** for real-time token delivery\n- **Sampling parameters** like temperature, top_p, and frequency penalties",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "11de76e1-528e-48ad-a468-5e9d9ca99fd1",
          "name": "Create chat completion",
          "request": {
            "name": "Create chat completion",
            "description": {
              "content": "Creates a model response for the given chat conversation.\n\nThe conversation is provided as an array of messages, where each message has a `role` (system, user, assistant, or tool) and `content`.\n\nSet `stream: true` to receive partial responses as server-sent events.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "chat",
                "completions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string,null>\",\n      \"name\": \"<string,null>\",\n      \"tool_call_id\": \"<string,null>\",\n      \"tool_calls\": [\n        {\n          \"id\": \"<string>\",\n          \"type\": \"<string>\",\n          \"function\": {\n            \"name\": \"<string>\",\n            \"arguments\": \"<string>\"\n          }\n        },\n        {\n          \"id\": \"<string>\",\n          \"type\": \"<string>\",\n          \"function\": {\n            \"name\": \"<string>\",\n            \"arguments\": \"<string>\"\n          }\n        }\n      ]\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string,null>\",\n      \"name\": \"<string,null>\",\n      \"tool_call_id\": \"<string,null>\",\n      \"tool_calls\": [\n        {\n          \"id\": \"<string>\",\n          \"type\": \"<string>\",\n          \"function\": {\n            \"name\": \"<string>\",\n            \"arguments\": \"<string>\"\n          }\n        },\n        {\n          \"id\": \"<string>\",\n          \"type\": \"<string>\",\n          \"function\": {\n            \"name\": \"<string>\",\n            \"arguments\": \"<string>\"\n          }\n        }\n      ]\n    }\n  ],\n  \"frequency_penalty\": \"<number,null-float>\",\n  \"max_tokens\": \"<integer,null-int32>\",\n  \"n\": \"<integer,null-int32>\",\n  \"presence_penalty\": \"<number,null-float>\",\n  \"stop\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"response_format\": {},\n  \"seed\": \"<integer,null-int64>\",\n  \"stream\": \"<boolean>\",\n  \"temperature\": \"<number,null-float>\",\n  \"tool_choice\": {},\n  \"tools\": [\n    {\n      \"type\": \"<string>\",\n      \"function\": {\n        \"name\": \"<string>\",\n        \"description\": \"<string,null>\",\n        \"parameters\": {}\n      }\n    },\n    {\n      \"type\": \"<string>\",\n      \"function\": {\n        \"name\": \"<string>\",\n        \"description\": \"<string,null>\",\n        \"parameters\": {}\n      }\n    }\n  ],\n  \"top_p\": \"<number,null-float>\",\n  \"user\": \"<string,null>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
