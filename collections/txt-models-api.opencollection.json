{
  "opencollection": "1.0.0",
  "info": {
    "name": "dottxt batches models API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dottxt.ai/v1/models",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists the models available to your API key.\n\nThe response includes model IDs that can be used in chat completion and embedding requests."
        },
        {
          "info": {
            "name": "Retrieve model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dottxt.ai/v1/models/:model",
            "params": [
              {
                "name": "model",
                "value": "",
                "type": "path",
                "description": "The model ID (e.g., `gpt-4`, `text-embedding-ada-002`)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves information about a specific model."
        }
      ]
    }
  ],
  "bundled": true
}